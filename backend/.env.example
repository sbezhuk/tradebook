# TradeBook Backend Environment Configuration

# Database: PostgreSQL (Default)
DATABASE_URL=postgresql+psycopg2://localhost:5432/tradebook

# Security
SECRET_KEY=tradebook_super_secret_jwt_key_development_change_in_prod_123456789
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gmail SMTP Configuration for OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TradeBook
SMTP_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEMO_BYPASS=true
